# Скопируйте эти переменные в Vercel → Settings → Environment Variables.
# Сам файл .env с реальными значениями в репозиторий не добавляйте.

# Telegram-бот (токен от @BotFather)
TELEGRAM_BOT_TOKEN=
# ID чата менеджеров (узнать командой /id в чате с ботом)
TELEGRAM_CHAT_ID=
# Любая длинная строка: латиница, цифры, _ и -
TELEGRAM_WEBHOOK_SECRET=

# Upstash Redis (появятся автоматически после подключения в Vercel → Storage)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Приложение для лидов (/admin). Пока не задано — приложение выключено.
# На сайте клиента оставьте пустым.
ADMIN_PASSWORD=

# Реальный HTTPS-адрес проекта, без пути (нужен только для настройки webhook)
PUBLIC_SITE_URL=

# Необязательно
# Часовой пояс для времени в заявках
DISPLAY_TZ=Europe/Moscow
# Заголовок сообщения о заявке в Telegram
LEAD_TITLE=🧽 Заявка
