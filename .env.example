TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_or_group_id
# Optional: topic ID for a forum-enabled Telegram group.
TELEGRAM_THREAD_ID=
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_string
PUBLIC_SITE_URL=https://your-project.vercel.app
KV_REST_API_URL=replace_with_upstash_redis_rest_url
KV_REST_API_TOKEN=replace_with_upstash_redis_rest_token
# Optional: comma-separated Telegram user IDs allowed to manage leads.
TELEGRAM_MANAGER_IDS=
ADMIN_PASSWORD=replace_with_a_strong_admin_password
# Optional. If omitted, changing ADMIN_PASSWORD also invalidates existing sessions.
ADMIN_SESSION_SECRET=
